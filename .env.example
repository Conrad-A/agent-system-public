# Copy to .env, fill in, chmod 600. NEVER commit .env (it is gitignored).
# Only the keys below live here — nothing else goes in .env (KICKOFF rule).
DEEPSEEK_API_KEY=sk-your-deepseek-key
# The body: runtime state outside the repo (lineages, events, costs,
# handoffs, dream copies). The v1 default is shown.
AGENT_RUNTIME=/home/you/Desktop/agent-system-runtime
# Optional flags (SPEC §4.2, §6):
#WORKER_RUNTIME=engine    # engine (default) | plain
#SELF_REVIEW=off          # on | off — one DeepSeek critique pass on briefs with no mechanical rung
# Step 8 (swarm, SPEC §7): web-search backends for lanes. Parallel is the
# primary, Exa the fallback; either alone works (tools/web_search.py picks
# by which keys are present). Lanes never see these in their shell env —
# swarm.py hands them over in a mode-600 file (SEARCH_AUTH_FILE).
PARALLEL_API_KEY=your-parallel-key
EXA_API_KEY=your-exa-key
