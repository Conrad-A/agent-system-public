# agent-system dream timer (SPEC §8.2): 19:45 local, every day. USER unit.
# Persistent=false on purpose: a night the machine was off is skipped, never
# run late at boot — the dream only proposes, and the next one diffs anyway.
[Unit]
Description=agent-system dream at 19:45

[Timer]
OnCalendar=*-*-* 19:45:00
Persistent=false

[Install]
WantedBy=timers.target
